# NOTE: for a zero-setup local demo (embedded PGlite database, mock LLM,
# credentials admin/demo) skip this file entirely and run `pnpm demo`.
# `pnpm demo` sets DEMO_MODE=1 itself; never set DEMO_MODE in this file or on
# a deployment.

# LLM provider configuration (Vercel AI SDK).
# Set LLM_PROVIDER to "anthropic" or "openai" ("mock" is used by `pnpm demo`).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. Personas (client, data owner, end-users) run on
# the persona model; the rubric judge and the consistency auditor run on the
# rubric model, a stronger one by default since its outputs feed assessment;
# the analyst agent runs on the analyst model, which defaults to the persona
# model. Anthropic defaults: claude-sonnet-5 (persona, analyst) and
# claude-opus-4-8 (rubric). OpenAI defaults: gpt-4o-mini for all three.
# Leave these commented out to use the defaults; a blank value also counts
# as unset. The spend guard and the cost scripts price models from
# lib/llm/prices.ts; add a dated price there before switching to a model it
# does not list.
# LLM_PERSONA_MODEL=claude-sonnet-5
# LLM_RUBRIC_MODEL=claude-opus-4-8
# LLM_ANALYST_MODEL=claude-sonnet-5

# Pseudonymisation salt for HMAC-SHA256 hashing of learner IDs and of
# sandbox client addresses. Required, at least 32 characters, and never a
# value copied from documentation: generate it with `openssl rand -hex 32`.
# Rotating this value starts a new pseudonymisation epoch: old and new rows
# can no longer be linked to the same learner. Rotate each term or on
# suspected exposure.
PSEUDONYM_SALT=

# Log retention. The daily /api/cron/cleanup job deletes engagement messages
# and events older than RETENTION_DAYS (default 180, one semester plus
# marking time), blanks the text of data requests of the same age, and
# deletes sandbox seats older than 30 days with everything under them.
# Reviewer-visible showcase cohorts are exempt. CRON_SECRET authenticates the Vercel cron invocation;
# generate with `openssl rand -hex 32`. If unset the purge endpoint refuses
# to run.
RETENTION_DAYS=180
CRON_SECRET=

# Vercel Postgres (Neon). Pulled automatically with `vercel env pull`.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Auth.js v5 core config. Instructor sign-in uses the Credentials provider
# (ADMIN_EMAIL + ADMIN_PASSWORD_HASH, configured below).
# AUTH_SECRET: generate with `openssl rand -hex 32`
#
# AUTH_URL: the public origin of the deployment (no trailing slash). Leave it
# unset unless the app sits behind a proxy that rewrites the host: invite and
# resume links then follow the host the request arrived on, so a tunnel, a LAN
# address, or a preview deployment hands out links that work. A value left at
# http://localhost:3000 is ignored when the request came in on another host.
AUTH_SECRET=
# AUTH_URL=https://your-app.example.edu

# Single-instructor admin credentials (Auth.js Credentials provider).
# ADMIN_EMAIL is what the instructor types in the email field; defaults to
# "admin". ADMIN_PASSWORD_HASH is a bcrypt hash. Generate via:
#   pnpm change-admin-password
# which prompts for the password (12 characters or more) and prints the line
# to paste here with every "$" already escaped. Add --vercel to set it on the
# linked Vercel project instead.
#
# IMPORTANT for local .env files: a bcrypt hash contains literal "$"
# sequences ($2b$12$...). Next.js loads .env via dotenv-expand, which treats
# $name as a variable reference and will silently corrupt the hash (login
# then always fails). Escape every "$" as "\$" when pasting a hash into
# .env.local. Vercel-managed env vars are injected directly and need no
# escaping.
ADMIN_EMAIL=admin
ADMIN_PASSWORD_HASH=

# Read-only reviewer account (for conference reviewers and other visitors).
# It sees only cohorts with "Visible to the read-only reviewer account" turned
# on in their configuration (showcase.reviewerVisible; a restored showcase
# snapshot has it on), and cannot change anything: no cohort edits, invites,
# overrides, stage forcing, agent runs or rescoring. Disabled while REVIEWER_PASSWORD_HASH is empty. Generate the
# hash the same way as the admin one:
#   pnpm change-admin-password --reviewer
# Under DEMO_MODE=1 (pnpm demo) the fixed login reviewer/reviewer works.
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD_HASH=

# Sandbox cohort for the landing page link and the bare /try route. Unset,
# the only cohort with open join is used; with two or more open cohorts the
# link is hidden until this names one. /try/<slug> always works for an open
# cohort.
# SANDBOX_COHORT_SLUG=

# Contact for demo visitors (an email address or a URL). The privacy page and
# the sandbox notice show it as the address for deletion requests from
# "Try as a learner" visitors, who have no instructor to ask. Set it on any
# deployment with the sandbox on; unset, the pages point to the paper and the
# repository README.
# DEMO_CONTACT=

# Daily spend guard, in USD, counted from 00:00 UTC over every metered model
# call (personas, client reactions, analyst steps, judge, auditor) at the
# list prices in lib/llm/prices.ts. Once reached, chat, gate submission,
# analyst runs and sandbox joins answer 429 until midnight UTC. Write a plain
# number (5, not "5 USD"). Empty means no limit, which is only sensible
# locally: set it on every deployment with a paid provider. Sandbox joins are
# refused while it is empty, except on the mock provider. A sandbox cohort
# also has its own daily limit in its configuration (Sandbox section).
# Recommended for the public demo: 5.
LLM_DAILY_BUDGET_USD=

# Output-token caps per call (optional). The values shown are the defaults
# in lib/llm/limits.ts. Lowering the persona, reaction or analyst cap below
# them truncates structured replies, which then fail validation and retry.
# LLM_MAX_TOKENS_PERSONA=900
# LLM_MAX_TOKENS_REACTION=700
# LLM_MAX_TOKENS_JUDGE_PER_CRITERION=250
# LLM_MAX_TOKENS_JUDGE_CAP=3000
# LLM_MAX_TOKENS_AUDITOR=200
# LLM_MAX_TOKENS_ANALYST=3500

# Optional links on the landing page. Each link shows only when set.
# NEXT_PUBLIC_PAPER_URL=
# NEXT_PUBLIC_VIDEO_URL=
