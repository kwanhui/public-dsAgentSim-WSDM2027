{
  "name": "agenticpracticum",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent LLM platform that simulates clients, data environments, and end-users so learners practise the end-to-end data-science engagement.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "demo": "tsx scripts/migrate-local.ts && pnpm demo:serve",
    "demo:serve": "DEMO_MODE=1 DB_DRIVER=pglite LLM_PROVIDER=mock AUTH_SECRET=demo-insecure-secret PSEUDONYM_SALT=demo-insecure-salt-for-the-local-mock-only AUTH_URL=http://localhost:${PORT:-3000} next dev",
    "demo:showcase": "tsx scripts/migrate-local.ts && DB_DRIVER=pglite tsx scripts/showcase-snapshot.ts restore --in demo/showcase-snapshot.json && pnpm demo:serve",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,yaml,yml,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "generate-datasets": "tsx scripts/generate-datasets.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "change-admin-password": "tsx scripts/change-admin-password.ts",
    "showcase:export": "tsx scripts/showcase-snapshot.ts export",
    "showcase:restore": "tsx scripts/showcase-snapshot.ts restore",
    "reviewer-path-check": "tsx scripts/reviewer-path-check.ts",
    "spend": "tsx scripts/spend.ts",
    "section5": "bash scripts/paper-metrics/section5.sh",
    "showcase:regen": "SHOWCASE_REGEN=1 bash scripts/replay/regen.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@auth/drizzle-adapter": "^1.11.2",
    "@electric-sql/pglite": "^0.5.4",
    "@hookform/resolvers": "^5.2.2",
    "@vercel/postgres": "^0.10.0",
    "ai": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.460.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.48.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/ui": "^2.1.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
